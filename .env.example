# cp .env.example .env して編集する(.env は追跡されない)
NEUTRINO_DIR=$HOME/NEUTRINO
# MuseScore 4 CLI(例: /Applications/MuseScore 4.app/Contents/MacOS/mscore)
MUSESCORE_BIN=
# Sonic Pi の場所(任意。/Applications/Sonic Pi.app にあれば不要)
#SONIC_PI_APP=/Applications/Sonic Pi.app
# ruby の場所(任意。PATH の ruby で足りなければ)
#SONIC_PI_RUBY=
