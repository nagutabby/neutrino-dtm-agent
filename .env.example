# cp .env.example .env して編集する(.env は追跡されない)
NEUTRINO_DIR=$HOME/NEUTRINO
# MuseScore 4 CLI(例: /Applications/MuseScore 4.app/Contents/MacOS/mscore)
MUSESCORE_BIN=
# scripts/play.sh が MIDI を試聴するときの SoundFont(任意。トラックの音源は spec と config/soundfonts.yaml で決まる)
SOUNDFONT=
# SoundFont を置くディレクトリ(.sf2 / .sf3。サブフォルダも探す。既定: リポジトリ直下の soundfonts/)。必要な音源は config/soundfonts.yaml
#SOUNDFONT_DIR=$HOME/SoundFonts
# 個別に指定したいとき(任意): SF_PHONK=/path/to/phonk.sf2
